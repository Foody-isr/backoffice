# Set this to your Go API (e.g. http://localhost:8080 for local dev)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Optional error monitoring. Leave blank locally; configure in Vercel per environment.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Optional shortcuts displayed in Dashboard > Operations.
NEXT_PUBLIC_SENTRY_DASHBOARD_URL=
NEXT_PUBLIC_GRAFANA_DASHBOARD_URL=
NEXT_PUBLIC_GITHUB_ACTIONS_URL=
